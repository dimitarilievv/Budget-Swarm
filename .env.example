# BudgetSwarm environment — full documented set (BS-015)
# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored — never commit real secrets.
# All keys are used SERVER-SIDE ONLY and are never exposed to the frontend.

# --- PostgreSQL (compose) ---
POSTGRES_USER=budgetswarm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=budgetswarm

# --- Backend DB connection (REQUIRED; host is the compose service name 'db') ---
DATABASE_URL=postgresql+psycopg://budgetswarm:change_me@db:5432/budgetswarm

# --- CORS (comma-separated allowed frontend origins; no wildcard) ---
# Includes the HTTPS proxy origin so the app works through Caddy (https://localhost)
# and when hitting the Vite dev server directly (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,https://127.0.0.1

# --- Frontend (Vite) ---
# Where the browser calls the API. Defaults to the HTTPS proxy (same origin as the app
# at https://localhost); set to http://localhost:8000 to bypass the proxy.
VITE_API_BASE_URL=https://localhost

# --- Auth / JWT (REQUIRED) ---
# JWT_SECRET signs access + refresh tokens. REQUIRED — the app fails fast at startup if
# it is missing. Use a long, random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
# Token lifetimes (optional; sane defaults shown). Access tokens are short-lived and sent
# in the Authorization header; refresh tokens are long-lived, stored hashed, and rotated.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate limiting (per client IP; not secrets) ---
# RATE_LIMIT_* applies to POST /api/generate-trip; AUTH_RATE_LIMIT_* is a stricter,
# separate window for POST /api/auth/login and /register. RATE_LIMIT_ENABLED is the
# master switch for both.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Provider keys ---
# ORS_API_KEY            OpenRouteService (car routing)      required for car mode
# TRAVELPAYOUTS_TOKEN    flight prices                       required for air mode
# PUBLIC_TRANSPORT_API_KEY  Rome2Rio/Omio (bus/train)        optional (fallback exists)
# OPENTRIPMAP_API_KEY    POIs (Overpass fallback needs no key)   optional
# APIFY_TOKEN            Inside Airbnb scraping              optional
ORS_API_KEY=
TRAVELPAYOUTS_TOKEN=
PUBLIC_TRANSPORT_API_KEY=
OPENTRIPMAP_API_KEY=
APIFY_TOKEN=

# --- LLM explanation layer (Ollama needs no key) ---
LLM_PROVIDER=ollama
LLM_API_KEY=

# Note: Open-Meteo (weather) and Overpass (POIs) require NO key.

# --- Scheduled jobs (ofelia) ---
# Inside Airbnb snapshot refresh cadence — 6-field cron (sec min hour dom mon dow).
# "Weekly" means CHECK weekly for a newer snapshot and import only if one exists;
# Inside Airbnb itself publishes roughly quarterly. Default: Mondays 04:00 UTC.
ACCOMMODATION_REFRESH_SCHEDULE=0 0 4 * * 1
# Reject a refreshed snapshot with fewer than this many normalized listings (guards
# against truncated/corrupt downloads replacing good data). Optional; default 50.
ACCOMMODATION_REFRESH_MIN_LISTINGS=50
