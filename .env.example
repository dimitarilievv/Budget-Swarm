# BudgetSwarm environment (BS-013 minimal set; BS-015 adds all provider keys)
# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored — never commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=budgetswarm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=budgetswarm

# --- Backend DB connection (host is the compose service name 'db') ---
DATABASE_URL=postgresql+psycopg://budgetswarm:change_me@db:5432/budgetswarm

# --- Provider keys (added/verified in BS-015; leave blank for now) ---
# ORS_API_KEY=
# TRAVELPAYOUTS_TOKEN=
# OPENTRIPMAP_API_KEY=
# APIFY_TOKEN=
# LLM_PROVIDER=ollama
