# Frontend environment (BS-016)
# Copy to .env for local overrides:  cp .env.example .env
# Only VITE_-prefixed vars are exposed to the client bundle.
# NEVER put secrets/API keys here — the frontend is public; keys stay server-side.

# Base URL of the backend API.
# Docker Compose / local dev: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
